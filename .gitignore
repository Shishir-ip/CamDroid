# Native build artifacts (sources + build.bat are tracked; DLLs ship in windows/vendor)
windows/native/vcam/obj/
*.obj
*.exp
*.ilk
*.pdb

# Vendored runtime binaries (adb, MediaPipe models, virtual-camera DLLs) ARE tracked
# so a fresh clone can build a working installer. Provenance: windows/vendor/README.md
!windows/vendor/
!windows/vendor/**

